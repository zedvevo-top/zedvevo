{
  "rewrites": [
    { "source": "/api/payments/verify", "destination": "/api/verify-payment.js" },
    { "source": "/api/lipila/webhook", "destination": "/api/webhook.js" },
    { "source": "/robots.txt", "destination": "/api/robots.js" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.js" },
    { "source": "/song/:id", "destination": "/api/song.js?slug=:id" },
    { "source": "/video/:id", "destination": "/api/video.js?slug=:id" },
    { "source": "/watch/:id", "destination": "/api/video.js?slug=:id" },
    { "source": "/artist/:id", "destination": "/api/artist.js?slug=:id" },
    { "source": "/((?!api/|assets/|sw\\.js|firebase-messaging-sw\\.js|manifest\\.json|favicon|app-icon).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
