{
  "engines": {
    "node": "20.x"
  },
  "rewrites": [
    { "source": "/api/payments/verify", "destination": "/api/verify-payment" },
    { "source": "/api/lipila/webhook", "destination": "/api/webhook" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/song/:id([a-zA-Z0-9_-]+)", "destination": "/api/song?slug=:id" },
    { "source": "/video/:id([a-zA-Z0-9_-]+)", "destination": "/api/video?slug=:id" },
    { "source": "/watch/:id([a-zA-Z0-9_-]+)", "destination": "/api/video?slug=:id" },
    { "source": "/artist/:id([a-zA-Z0-9_-]+)", "destination": "/api/artist?slug=:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps"
}
