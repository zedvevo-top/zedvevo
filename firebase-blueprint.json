    "WinnerOfMonth": {
      "title": "WinnerOfMonth",
      "description": "Featured monthly artist winner announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "artist_name": { "type": "string", "maxLength": 200 },
        "award": { "type": "string", "maxLength": 200 },
        "award_category": { "type": "string", "maxLength": 200 },
        "photo_url": { "type": "string", "maxLength": 1024 },
        "prize": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "is_published": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 64 },
        "updated_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "month", "year", "artist_name", "award", "is_published"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Administrator registry keyed by Firebase UID."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Private user profiles with PII and role/entitlement state."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII public user attribution profiles."
    },
    "/artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Public artist directory and streaming statistics."
    },
    "/songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "Music catalog tracks."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/Video" },
      "description": "Music video catalog."
    },
    "/upload_plans/{planId}": {
      "schema": { "$ref": "#/entities/UploadPlan" },
      "description": "Artist upload subscription plans."
    },
    "/user_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/UserSubscription" },
      "description": "User upload access subscriptions."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payment records strictly scoped to owner or admin."
    },
    "/awards/{awardId}": {
      "schema": { "$ref": "#/entities/Award" },
      "description": "Awards seasons."
    },
    "/award_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/AwardCategory" },
      "description": "Award categories."
    },
    "/nominees/{nomineeId}": {
      "schema": { "$ref": "#/entities/Nominee" },
